{
  "name": "monhabell-aventura",
  "version": "1.0.0",
  "private": true,
  "description": "Monhabell Aventura: La Noche Eterna — versión Android (Capacitor)",
  "type": "module",
  "scripts": {
    "web": "node scripts/copiar-web.mjs",
    "probar": "echo Abre: http://localhost:8099/index.html?nivel=24^&personaje=caballera && python -m http.server 8099",
    "sync": "npm run web && npx cap sync android",
    "apk": "powershell -ExecutionPolicy Bypass -File scripts/construir-apk.ps1",
    "llave": "powershell -ExecutionPolicy Bypass -File scripts/crear-llave.ps1",
    "play": "powershell -ExecutionPolicy Bypass -File scripts/construir-play.ps1"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "8.5.3",
    "@capacitor/core": "8.5.3"
  }
}
